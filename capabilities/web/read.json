      "type": "string",
      "required": true
    }
  },
  "execution": {
    "type": "python",
    "handler": "tools.web.read.read"
  },
  "latency": {
    "expected_ms": 3000
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": []
}
