      "required": false,
      "default": 5
    }
  },
  "execution": {
    "type": "python",
    "handler": "tools.bugs.known.find"
  },
  "version": "1.0.0",
  "category": "bugs",
  "transport": "mcp",
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "latency": {
    "expected_ms": 20
  },
  "related": [
    "bugs.report",
    "bugs.find",
    "bugs.list",
    "observe.log"
  ]
}
