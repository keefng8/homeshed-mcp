{
  "id": "bugs.find",
  "name": "Known Bugs Find",
  "description": "Has this error been seen before? Paste it and get the known cause and fix.",
  "risk": "read",
  "requires": [],
  "aliases": [
    "seen this error before",
    "known fix for",
    "why does this error",
    "known bug"
  ],
