{
  "id": "proxmox.vm.snapshot",
  "name": "Snapshot a Proxmox Guest",
  "version": "1.0.0",
  "description": "Take a snapshot of a VM or container. dry_run defaults true; dry_run=false only queues it for the owner's approval. Never deletes or rolls back.",
  "category": "proxmox",
  "risk": "write",
  "requires": [
    "Proxmox VE API token (PROXMOX_TOKEN_ID, or PROXMOX_API_TOKEN)"
  ],
  "transport": "mcp",
  "aliases": [
    "snapshot proxmox vm",
    "take a snapshot before upgrading",
    "backup point for container"
  ],
  "inputs": {
    "vmid": {
      "type": "integer",
      "required": true
    },
    "snapname": {
      "type": "string",
      "required": true
    },
    "node": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "kind": {
      "type": "string",
      "required": false,
      "default": "qemu",
      "enum": [
        "qemu",
        "lxc"
      ]
    },
    "description": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "dry_run": {
      "type": "boolean",
      "required": false,
      "default": true
    }
  },
  "execution": {
    "type": "http",
    "handler": "tools.proxmox.vm_snapshot.vm_snapshot"
  },
  "latency": {
    "expected_ms": 800
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": [
    "proxmox.nodes.list",
    "proxmox.node.status",
    "proxmox.vms.list",
    "proxmox.vm.status",
    "proxmox.storage.list"
  ],
  "approval": "owner (proxmox_pending.py; POST /proxmox/pending/<id>/approve)"
}
