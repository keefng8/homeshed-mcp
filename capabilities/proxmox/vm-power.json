{
  "id": "proxmox.vm.power",
  "name": "Start, Stop, Shut Down or Reboot a Proxmox Guest",
  "version": "1.0.0",
  "description": "Start, stop, shut down or reboot a VM or container. dry_run defaults true; dry_run=false only queues it for the owner's approval (POST /proxmox/pending/<id>/approve).",
  "category": "proxmox",
  "risk": "write",
  "requires": [
    "Proxmox VE API token (PROXMOX_TOKEN_ID, or PROXMOX_API_TOKEN)"
  ],
  "transport": "mcp",
  "aliases": [
    "start proxmox vm",
    "stop proxmox vm",
    "shut down container on proxmox",
    "reboot proxmox vm"
  ],
  "inputs": {
    "vmid": {
      "type": "integer",
      "required": true
    },
    "action": {
      "type": "string",
      "required": true,
      "enum": [
        "start",
        "stop",
        "shutdown",
        "reboot"
      ]
    },
    "node": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "kind": {
      "type": "string",
      "required": false,
      "default": "qemu",
      "enum": [
        "qemu",
        "lxc"
      ]
    },
    "dry_run": {
      "type": "boolean",
      "required": false,
      "default": true
    }
  },
  "execution": {
    "type": "http",
    "handler": "tools.proxmox.vm_power.vm_power"
  },
  "latency": {
    "expected_ms": 800
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": [
    "proxmox.nodes.list",
    "proxmox.node.status",
    "proxmox.vms.list",
    "proxmox.vm.status",
    "proxmox.storage.list"
  ],
  "approval": "owner (proxmox_pending.py; POST /proxmox/pending/<id>/approve)"
}
