{
  "id": "proxmox.tasks.list",
  "name": "List Proxmox Tasks",
  "version": "1.0.0",
  "description": "Recent Proxmox tasks on a node (starts, stops, snapshots, backups) and how they ended; follow up an approved change here. Read-only.",
  "category": "proxmox",
  "risk": "read",
  "requires": [
    "Proxmox VE API token (PROXMOX_TOKEN_ID, or PROXMOX_API_TOKEN)"
  ],
  "transport": "mcp",
  "aliases": [
    "proxmox tasks",
    "did the vm start",
    "proxmox task log",
    "failed proxmox tasks"
  ],
  "inputs": {
    "node": {
      "type": "string",
      "required": true
    },
    "limit": {
      "type": "integer",
      "required": false,
      "default": 20
    },
    "errors_only": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "vmid": {
      "type": "integer",
      "required": false,
      "default": 0
    }
  },
  "execution": {
    "type": "http",
    "handler": "tools.proxmox.tasks_list.tasks_list"
  },
  "latency": {
    "expected_ms": 400
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": [
    "proxmox.nodes.list",
    "proxmox.node.status",
    "proxmox.vms.list",
    "proxmox.vm.status",
    "proxmox.storage.list"
  ]
}
