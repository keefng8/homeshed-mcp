{
  "id": "secrets.transcript_scan",
  "name": "Transcript Secret Scan",
  "version": "1.0.0",
  "description": "Find API keys, tokens and passwords saved in Claude Code's own transcripts, and say where to rotate each. Never returns a secret: kind, length and a fingerprint only.",
  "category": "secrets",
  "risk": "read",
  "requires": [],
  "transport": "mcp",
  "aliases": [
    "did i leak a key to claude",
    "secrets in my claude transcripts",
    "which keys should i rotate",
    "scan claude history for passwords",
    "api key in chat history"
  ],
  "inputs": {
    "days": { "type": "integer", "required": false, "default": 0 },
    "detail": { "type": "string", "required": false, "enum": ["compact", "full"], "default": "compact" }
  },
  "execution": {
    "type": "python",
    "handler": "tools.secrets.transcript_scan.transcript_scan"
  },
  "latency": { "expected_ms": 60000 },
  "cache": { "enabled": false, "freshness": "real_time" },
  "related": ["bugs.find"]
}
