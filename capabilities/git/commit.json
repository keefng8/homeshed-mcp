{
  "id": "git.commit",
  "name": "Git Commit",
  "version": "1.0.0",
  "description": "Stage and create a git commit. Fully autonomous, no confirmation step.",
  "category": "git",
  "risk": "write",
  "requires": [],
  "transport": "mcp",
  "aliases": [
    "git commit",
    "commit changes",
    "save changes",
    "create a commit"
  ],
  "inputs": {
    "path": { "type": "string", "required": true },
    "message": { "type": "string", "required": true },
    "files": { "type": "array", "required": false },
    "add_all": { "type": "boolean", "required": false, "default": false }
  },
  "execution": {
    "type": "subprocess",
    "handler": "tools.git.commit.commit"
  },
  "latency": {
    "expected_ms": 500
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": ["git.status", "git.branch", "git.push"]
}
