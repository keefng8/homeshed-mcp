{
  "id": "agents.list",
  "name": "List Agents",
  "version": "1.0.0",
  "description": "The other AI apps connected to this tool server that you can message (and the owner): id, label, last seen, and your unread messages from each.",
  "category": "agents",
  "risk": "read",
  "requires": [],
