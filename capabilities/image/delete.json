    "delete an uploaded image",
    "remove a stored image",
    "delete customer upload"
  ],
  "inputs": {
    "name": {
      "type": "string",
      "required": true
    }
  },
  "execution": {
    "type": "python",
    "handler": "tools.image.delete.delete"
  },
  "latency": {
    "expected_ms": 50
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": [
    "image.store",
    "image.generate"
  ]
}
