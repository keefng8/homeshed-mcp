{
  "id": "docker.container.restart",
  "name": "Restart Docker Container",
  "version": "1.0.0",
  "description": "Restart a container. dry_run defaults true and IS the confirmation step.",
  "category": "docker",
  "risk": "write",
  "requires": ["Docker socket"],
  "transport": "mcp",
  "aliases": [
    "restart container",
    "reboot container",
    "bounce container"
  ],
  "inputs": {
    "container": {
      "type": "string",
      "required": true
    },
    "dry_run": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "timeout": {
      "type": "integer",
      "required": false,
      "default": 10
    }
  },
  "execution": {
    "type": "docker_sdk",
    "handler": "tools.docker.container_restart.container_restart"
  },
  "latency": {
    "expected_ms": 500
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": ["docker.container.list", "docker.container.inspect"]
}
