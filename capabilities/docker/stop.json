{
  "id": "docker.container.stop",
  "name": "Stop Docker Container",
  "version": "1.0.0",
  "description": "Stop a container. dry_run defaults true and IS the confirmation step.",
  "category": "docker",
  "risk": "write",
  "requires": ["Docker socket"],
  "transport": "mcp",
  "aliases": [
    "stop container",
    "halt container",
    "shut down container"
  ],
  "inputs": {
    "container": {
      "type": "string",
      "required": true
    },
    "dry_run": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "timeout": {
      "type": "integer",
      "required": false,
      "default": 10
    }
  },
  "execution": {
    "type": "docker_sdk",
    "handler": "tools.docker.container_stop.container_stop"
  },
  "latency": {
    "expected_ms": 500
  },
  "cache": {
    "enabled": false,
    "freshness": "real_time"
  },
  "related": ["docker.container.list", "docker.container.start", "docker.container.restart"]
}
