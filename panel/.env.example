MCP_BASE_URL=http://mcp-server:8765
MCP_AUTH_TOKEN=
MCP_HOST_HEADER=localhost:8765

# Optional: a memory-core service. Leave it empty and memory is HomeShed's own, built in.
MEMORY_CORE_BASE_URL=
MEMORY_CORE_BEARER=
MEMORY_SERVICE_ID=default
MEMORY_USER_KEY=
MEMORY_TEAM_ID=
MEMORY_USER_ID=
MEMORY_AGENT_ID=

# Leave it empty and the panel makes a password on its first start, prints it once to its log (docker logs), and
# keeps only its hash. There's no way to turn the sign-in off.
DASHBOARD_PASSWORD=
# View-only logins are managed on the Settings page (stored in /data/viewers.json). An older single
# viewer password set here is moved into that list once, as "friend"; it can then be removed.
DASHBOARD_VIEWER_PASSWORD=
# The address people outside your network use (sent with new view-only logins), e.g. https://panel.example.com
DASHBOARD_PUBLIC_URL=

# --- Optional (each is explained in README.md) ---
# Signs the sign-in cookie; empty: it comes from the owner password.
DASHBOARD_SESSION_SECRET=
# Lets the owner show a stored key's value after re-entering the password; empty: values are never shown.
VAULT_REVEAL_KEY=
# Your ntfy server's health address, e.g. https://ntfy.sh/v1/health
NTFY_HEALTH_URL=
# A central guide library; empty: the guides that come with the panel.
GUIDE_LIBRARY_URL=
# A helper service on your PC (context monitor, rule monitoring, past sessions), and its token.
GPU_SERVICE_URL=
GPU_SERVICE_TOKEN=
# 1 only behind a reverse proxy you run.
TRUST_PROXY_HEADERS=
# Where the panel keeps its own files (default /data).
PANEL_DATA_DIR=
