# HomeShed settings. Copy to .env and fill in what you use. Never commit your real .env.
# Every variable is explained in docs/configuration.md. Only the first block is needed, and only for HTTP/Docker:
# `homeshed-mcp init` writes MCP_AUTH_TOKEN and VAULT_KEY for you.

# --- HTTP / Docker only (not needed for the one-line uvx install) -------------------------------------------------
# Bearer token every client must send. `homeshed-mcp init` generates one.
MCP_AUTH_TOKEN=
# Host headers the server accepts, comma separated (the server refuses to start without it over HTTP).
# Add your LAN name or address if other machines connect, e.g. localhost:8765,127.0.0.1:8765,myserver.lan:8765
MCP_ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
# Allowed Origin headers, only needed for browser-based clients. Empty is fine for Claude Code and Desktop.
MCP_ALLOWED_ORIGINS=
MCP_PORT=8765
# Where HTTP listens. Unset = this machine only (127.0.0.1). 0.0.0.0 accepts other machines: add their names to
# MCP_ALLOWED_HOSTS too. The Docker image already sets 0.0.0.0 inside the container, so leave this commented out there
# (an empty value here would override it and cut the container off).
# MCP_BIND=0.0.0.0
# Encrypts stored credentials. `homeshed-mcp init` generates one. Keep it: without it, saved credentials can't be read.
VAULT_KEY=

# --- Where state lives ------------------------------------------------------------------------------------------
# Default: a per-user folder (uvx) or /data (Docker).
DATA_DIR=

# --- Safety switches --------------------------------------------------------------------------------------------
# Tools that change things ship switched off: git commit/push/pull/clone/branch, Docker container
# start/stop/restart, and dev.* (which runs code). List tool ids or groups to turn them on, comma separated:
# git.commit,git.push or git.*. "*" turns on all of them except dev.*, which must be named (dev.*) because
# it runs code.
ENABLE_TOOLS=
# network.port_check and network.dns.lookup reach only public addresses, so this server can't be used to probe
# your private network. To allow your own network, list its ranges, comma separated: 192.168.0.0/16.
# A wrong entry stops the tool with an error rather than being ignored.
NETWORK_ALLOWED_CIDRS=

# --- Your own model (optional) ----------------------------------------------------------------------------------
# Any OpenAI-compatible server: Ollama (http://localhost:11434/v1), llama.cpp, LM Studio, vLLM.
# `homeshed-mcp setup --model` finds a running one and writes these two lines for you.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# --- Cloud models (optional) ------------------------------------------------------------------------------------
# Used by local_ai.ask when your own model is busy or missing. Prompts sent to them leave your machine;
# callers pass allow_cloud=false for anything private. Set any you have; each has a free tier.
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OVH_AI_ENDPOINTS_TOKEN=
# An OpenAI-compatible gateway you run (e.g. LiteLLM); only its nvidia-* models are used.
LOCAL_AI_GATEWAY_URL=
LOCAL_AI_GATEWAY_KEY=

# --- Memory -----------------------------------------------------------------------------------------------------
# Built in, nothing to set: a SQLite file, one memory per project. Default: DATA_DIR/usage/memory.db
MEMORY_DB_PATH=
# Optional: a self-hosted memory-core (TencentDB Agent Memory) instead. Setting MEMORY_CORE_BASE_URL switches to it,
# and it needs all seven values; the IDs come from memory-core's bootstrapped user. Nothing is copied between them.
MEMORY_CORE_BASE_URL=
MEMORY_CORE_BEARER=
MEMORY_SERVICE_ID=default
MEMORY_USER_KEY=
MEMORY_TEAM_ID=
MEMORY_USER_ID=
MEMORY_AGENT_ID=

# --- Notifications (optional): notify.send through ntfy ---------------------------------------------------------
# Your ntfy server (https://ntfy.sh or your own) and an access token for it.
NTFY_BASE_URL=
NTFY_AUTH_TOKEN=
# The topic used when a call names none. Subscribe to it in the ntfy app.
NTFY_DEFAULT_TOPIC=

# --- Other optional connections ---------------------------------------------------------------------------------
# uptime.status: path to Uptime Kuma's kuma.db (mounted read-only in Docker). Default: DATA_DIR/kuma/kuma.db
KUMA_DB_PATH=
# Docker tools: leave unset to use the local Docker socket. To manage another machine, use SSH, never bare
# tcp:// (port 2375 is Docker's unauthenticated API: anyone who reaches it gets root). Example:
# DOCKER_HOST=ssh://user@my-server
DOCKER_HOST=
# bugs.find's opt-in GitHub search: a token raises GitHub's rate limit. Optional.
GITHUB_SEARCH_TOKEN=

# --- Proxmox VE (optional): the proxmox.* tools ----------------------------------------------------------------
# Better kept in the Control Panel's Credentials (the vault), under these same names: then no restart is needed.
# An API token (Datacenter > Permissions > API Tokens); one token covers the whole cluster. Either the whole token in
# PROXMOX_TOKEN_ID (user@realm!tokenname=secret, optional PVEAPIToken= prefix), or the id there and the secret
# in PROXMOX_TOKEN_SECRET. PROXMOX_API_TOKEN / PROXMOX_HOST are general names for the same.
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# https://<address>:8006, no path.
PROXMOX_HOST=
# A fresh Proxmox has a self-signed certificate: point PROXMOX_CA_PATH at a copy of its pve-root-ca.pem, or set
# PROXMOX_VERIFY_TLS=false on a trusted LAN. Default true.
PROXMOX_VERIFY_TLS=
PROXMOX_CA_PATH=

# --- Image generation (image.generate / image.status / image.providers.list) ---------------------------------------
# The free local GPU service (stable-diffusion.cpp); falls back to LOCAL_AI_DECIDE_BASE_URL.
IMAGE_BASE_URL=
# Paid remote providers: each is enabled only when its key is stored. Better kept in the Control Panel's Credentials
# (the vault) under these same names. Every call to one of them costs money; image.providers.list shows which are set.
OPENAI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
# Optional: the provider image.generate uses when none is named (default local-sdcpp, free). Setting a paid one here
# makes every unspecified call paid.
IMAGE_DEFAULT_PROVIDER=
# Where paid providers' images and their licence sidecars are saved. Default DATA_DIR/usage/images.
IMAGE_OUTPUT_DIR=
# Paid providers are also switched OFF by default, with a daily cap of 0, whatever keys are stored: switch them on in
# the Control Panel (Settings > Image generation; saved in usage/settings.json). Today's counts are kept here.
# Default DATA_DIR/usage/image_daily.json.
IMAGE_USAGE_FILE=

# --- Language models (llm.chat): a paid-model relay for apps on other machines, so they never hold the key
# XAI_API_KEY (above, shared with image generation) is better kept in the Control Panel's Credentials (the vault).
# Switched OFF by default with a daily cap of 0: Control Panel > Settings > AI and tools > Language models.
# Today's counts and the usage log (client, model, tokens, cost; never text). Defaults DATA_DIR/usage/llm_daily.json
# and DATA_DIR/usage/llm_usage.jsonl.
LLM_USAGE_FILE=
LLM_USAGE_LOG=

# --- Online shops (etsy.*, printify.*): read-only proxy tools for apps on other machines
# Better kept in the Control Panel's Credentials (the vault) under these names. Both switched off by default:
# Control Panel > Settings > Online shops. The Etsy refresh token is rotated and written back to the vault.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
